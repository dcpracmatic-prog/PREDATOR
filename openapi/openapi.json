{
  "openapi": "3.1.0",
  "info": {
    "title": "PREDATOR HTTP API",
    "version": "0.1.0",
    "description": "Fachada HTTP B2B sobre planificador IS y auditoría firmable (ztge.audit.v1 / ztge.envelope.v1). Resource-aware request sizing and hardware profile.",
    "license": {
      "name": "AGPL-3.0",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local default"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "status",
        "summary": "Engine and MORPH status",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plan": {
      "post": {
        "operationId": "planIndependent",
        "summary": "Compute independent set",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit": {
      "post": {
        "operationId": "auditGraph",
        "summary": "Full audit (optionally signed)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audit response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON"
          }
        }
      }
    },
    "/v1/plan/native-file": {
      "post": {
        "operationId": "nativePlanFile",
        "summary": "Stream raw JSON to the native MORPH parser",
        "description": "Available by default; stages the upload and a bounded native edge spool, with a disk-derived cap up to 50 GiB. The 50 GiB value is a transport ceiling, not a claim that MORPH can solve a graph of that size. Requires X-Content-SHA256 over the exact request body and a configured dump_morph built with --json support.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Content-SHA256",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native MORPH solution with independent-set verification trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, hash mismatch, or graph rejected by native parser"
          },
          "503": {
            "description": "Native solver unavailable or concurrency limit reached"
          },
          "413": {
            "description": "Request exceeds the available staging/spool disk budget"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "engine": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "engine",
          "version",
          "morph",
          "resources",
          "max_request_bytes"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "clan_version": {
            "type": "string"
          },
          "morph": {
            "type": "object",
            "additionalProperties": true
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": true
          },
          "max_request_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "GraphInput": {
        "type": "object",
        "required": [
          "n",
          "edges"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "maxItems": 10000000
          },
          "directed": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "PlanRequest": {
        "type": "object",
        "required": [
          "graph"
        ],
        "properties": {
          "graph": {
            "$ref": "#/components/schemas/GraphInput"
          },
          "method": {
            "type": "string",
            "enum": [
              "auto",
              "morph",
              "gwmin"
            ],
            "default": "auto"
          },
          "budget_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000,
            "default": 100
          },
          "seed": {
            "type": "integer",
            "default": 1,
            "minimum": 0
          },
          "auto_n_threshold": {
            "type": "integer",
            "minimum": 1,
            "default": 1500
          }
        }
      },
      "PlanResponse": {
        "type": "object",
        "required": [
          "nodes",
          "size",
          "verified",
          "trace"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "size": {
            "type": "integer"
          },
          "verified": {
            "type": "boolean"
          },
          "trace": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "AuditRequest": {
        "type": "object",
        "required": [
          "graph"
        ],
        "properties": {
          "graph": {
            "$ref": "#/components/schemas/GraphInput"
          },
          "method": {
            "type": "string",
            "enum": [
              "auto",
              "morph",
              "gwmin"
            ],
            "default": "auto"
          },
          "budget_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000,
            "default": 100
          },
          "seed": {
            "type": "integer",
            "default": 1,
            "minimum": 0
          },
          "sign": {
            "type": "boolean",
            "default": true
          },
          "key_id": {
            "type": "string",
            "default": "hmac:default"
          },
          "include_dense": {
            "type": "boolean",
            "default": true
          },
          "k_core_k": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          },
          "graph_source": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AuditResponse": {
        "type": "object",
        "required": [
          "report"
        ],
        "properties": {
          "report": {
            "type": "object",
            "additionalProperties": true,
            "description": "ztge.audit.v1"
          },
          "envelope": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "ztge.envelope.v1"
          },
          "signed": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
